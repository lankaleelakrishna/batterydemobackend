# Copy to .env for local development. Never commit .env or put real secrets in this file.

NODE_ENV=development
PORT=5000
# Public base URL used to build product image links.
PUBLIC_URL=http://127.0.0.1:5000

# Comma-separated storefront origins allowed by CORS. Required in production. "*" is refused.
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Migrations are applied explicitly (npm run migration:run); the schema is never synchronised.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=volten
PG_PASSWORD=
PG_DATABASE=volten_dev
PG_SSL=false

# JWT. JWT_SECRET must be at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cOhtH0Hd1sgXl3vFB7OEHSVa0qOUexQU/t8fSwe5k0eYY7j3VlUw4dWrayBQjOL1mJCNmWlgim212azltgRpBcmLi4mYoNunN45yQEVDprieIIDKHtJidVRLz
JWT_EXPIRES_IN=12h
JWT_ISSUER=volten-api
JWT_AUDIENCE=volten-storefront

# Rate limiting (requests per window, per client).
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120
# Stricter limits per minute for sign-in and sign-up, and for review and newsletter writes.
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_WRITE_LIMIT=5

# Upload directory for product images (served at /uploads).
UPLOAD_DIR=uploads
LOG_REQUESTS=true

# Development demo data. Never enable in production.
SEED_DEMO_DATA=false
DEMO_ADMIN_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# ---- Business rules. Leave unset until approved. Checkout refuses orders while unset. ----
# Flat shipping fee, in paise (100 paise = Rs 1).
SHIPPING_FEE_PAISE=
# GST rate in basis points (1800 = 18%).
GST_RATE_BASIS_POINTS=
# "inclusive" if listed prices already include GST, "exclusive" if GST is added at checkout.
GST_MODE=
# Minimum order subtotal in paise. Unset means no minimum is enforced.
MIN_ORDER_PAISE=
# Cash on delivery is unavailable until this is "true".
COD_ENABLED=false
# Comma-separated 6-digit pincodes we deliver to. Unset means checkout is refused.
SERVICEABLE_PINCODES=
